default_platform(:ios)

platform :ios do
  # Shared API key helper — uses env vars with fallbacks
  def get_api_key
    # Try key_content first (base64-encoded .p8 from env var), fall back to local file
    if ENV["APP_STORE_KEY_CONTENT"] || ENV["IAP_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["IAP_KEY_ID"] || "TS9A6TPWWR",
        issuer_id: ENV["IAP_ISSUER_ID"] || "7e6f7a23-b6f4-45ba-a169-32cb4d378fc2",
        key_content: ENV["APP_STORE_KEY_CONTENT"] || ENV["IAP_KEY_CONTENT"],
        is_key_content_base64: false,
        in_house: false
      )
    else
      # Local file fallback for dev machine
      key_path = ENV["APP_STORE_KEY_PATH"] || File.expand_path("~/Downloads/AuthKey_TS9A6TPWWR.p8")
      app_store_connect_api_key(
        key_id: ENV["IAP_KEY_ID"] || "TS9A6TPWWR",
        issuer_id: ENV["IAP_ISSUER_ID"] || "7e6f7a23-b6f4-45ba-a169-32cb4d378fc2",
        key_filepath: key_path,
        in_house: false
      )
    end
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    deliver(
      api_key: get_api_key,
      app_identifier: "com.mjsuperstars.app",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_metadata: false,
      skip_screenshots: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      primary_category: "HEALTH_AND_FITNESS",
      secondary_category: "LIFESTYLE",
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload screenshots only"
  lane :upload_screenshots do
    deliver(
      api_key: get_api_key,
      app_identifier: "com.mjsuperstars.app",
      screenshots_path: "./fastlane/screenshots",
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "Submit for App Store review"
  lane :submit_for_review do
    deliver(
      api_key: get_api_key,
      app_identifier: "com.mjsuperstars.app",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_metadata: false,
      skip_screenshots: false,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: true,
        export_compliance_is_exempt: true,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      }
    )
  end
end
