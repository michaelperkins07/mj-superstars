# ============================================================
# MJ's Superstars Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mj_superstars

# Redis (optional locally, required for production job queues)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Encryption (32 bytes / 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Apple Push Notifications
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_PATH=./certs/AuthKey.p8
APNS_BUNDLE_ID=com.mjsuperstars.app

# Apple App Store (In-App Purchase verification)
IAP_ISSUER_ID=your-app-store-connect-issuer-id
IAP_KEY_ID=your-app-store-connect-api-key-id
IAP_KEY_CONTENT=base64-encoded-p8-key-content
APP_BUNDLE_ID=com.mjsuperstars.app

# Frontend URL (CORS + email links)
CLIENT_URL=http://localhost:3000

# Admin API
ADMIN_SECRET=your-admin-secret-for-deep-health-checks

# Email (Resend)
RESEND_API_KEY=re_your-resend-api-key

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Apple Sign-In (optional for web, not needed for native iOS)
# APPLE_CLIENT_ID=com.mjsuperstars.web

# Analytics (optional)
MIXPANEL_TOKEN=your-mixpanel-token

# Error Tracking (optional)
SENTRY_DSN=https://your-sentry-dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev

# CORS (same as CLIENT_URL for web, Capacitor origins are auto-allowed)
CORS_ORIGIN=http://localhost:3000

# Feature Flags (optional)
ENABLE_BUDDY_SYSTEM=true
ENABLE_HEALTHKIT=true
ENABLE_WATCH_APP=true
